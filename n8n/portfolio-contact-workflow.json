    {
      "parameters": {
        "jsCode": "const request = $input.first().json;\nconst body = request.body ?? request;\n\nconst name = String(body.name ?? '').trim().replace(/[\\r\\n]+/g, ' ');\nconst email = String(body.email ?? '').trim().replace(/[\\r\\n]+/g, '');\nconst message = String(body.message ?? '').trim();\nconst website = String(body.website ?? '').trim();\nconst consentValue = String(body.consent ?? '').toLowerCase();\nconst hasConsent = body.consent === true || ['on', 'true', '1', 'yes'].includes(consentValue);\nconst emailPattern = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\nconst isValid =\n  website === '' &&\n  name.length >= 1 &&\n  name.length <= 100 &&\n  email.length <= 254 &&\n  emailPattern.test(email) &&\n  message.length >= 1 &&\n  message.length <= 5000 &&\n  hasConsent;\n\nreturn [{\n  json: {\n    isValid,\n    name,\n    email,\n    message,\n    receivedAt: new Date().toISOString(),\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
